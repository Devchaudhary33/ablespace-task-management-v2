{
  "services": {
    "frontend": {
      "root": "ablespace-task-management/frontend",
      "framework": "nextjs"
    },
    "backend": {
      "root": "ablespace-task-management/backend",
      "framework": "nestjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/backend/(.*)",
      "destination": {
        "type": "service",
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "frontend"
      }
    }
  ]
}